<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="https://irihi.tech/semi"
             xmlns:vm="using:GOZA.Dock.Minimal.ViewModels"
             xmlns:views="using:GOZA.Dock.Minimal.Views"
             x:Class="GOZA.Dock.Minimal.App"
             RequestedThemeVariant="Default">
    <Application.DataTemplates>
        <DataTemplate DataType="vm:PlainTabViewModel">
            <views:PlainPanel />
        </DataTemplate>
        <DataTemplate DataType="vm:BrowserTabViewModel">
            <views:BrowserPanel />
        </DataTemplate>
    </Application.DataTemplates>
    <Application.Styles>
        <semi:SemiTheme />
        <StyleInclude Source="avares://GOZA.Dock/Themes/DockShellStyles.axaml" />
    </Application.Styles>
</Application>
