<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GOZA.Dock.Minimal"
        xmlns:dock="using:GOZA.Dock"
        x:Class="GOZA.Dock.Minimal.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="960"
        Height="640">

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Padding="8,6"
                BorderThickness="0"
                BorderBrush="{DynamicResource surface.border}">
            <WrapPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,6">
                    <TextBlock Text="主题" VerticalAlignment="Center" />
                    <ComboBox Width="240"
                              ItemsSource="{Binding Themes}"
                              SelectedItem="{Binding ColorTheme}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="dock:VsCodeColorTheme">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,6">
                    <TextBlock Text="区域风格" VerticalAlignment="Center" />
                    <ComboBox Width="150"
                              ItemsSource="{Binding PanePresentations}"
                              SelectedItem="{Binding PanePresentation}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,6">
                    <TextBlock Text="Tab 风格" VerticalAlignment="Center" />
                    <ComboBox Width="130"
                              ItemsSource="{Binding TabPresentations}"
                              SelectedItem="{Binding TabPresentation}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,6">
                    <TextBlock Text="Tab 条尺寸" VerticalAlignment="Center" />
                    <NumericUpDown Width="148"
                                   Minimum="20"
                                   Maximum="72"
                                   Increment="1"
                                   FormatString="0"
                                   Value="{Binding TabStripSize}" />
                </StackPanel>
                <CheckBox Content="显示方向按钮"
                          Margin="0,0,16,6"
                          VerticalAlignment="Center"
                          IsChecked="{Binding ShowTabPlacementButton}" />
                <CheckBox Content="显示最大化按钮"
                          Margin="0,0,16,6"
                          VerticalAlignment="Center"
                          IsChecked="{Binding ShowMaximizeButton}" />
            </WrapPanel>
        </Border>

        <DockShell Grid.Row="1"
                   ColorTheme="{Binding ColorTheme}"
                   PanePresentation="{Binding PanePresentation}"
                   TabPresentation="{Binding TabPresentation}"
                   TabStripSize="{Binding TabStripSize}">
            <Grid ColumnDefinitions="220,Auto,*">
                <Grid Grid.Column="0" RowDefinitions="*,Auto,*">
                    <DockRegion Grid.Row="0"
                                ItemsSource="{Binding LeftTopTabs}"
                                ShowMaximizeButton="{Binding ShowMaximizeButton}"
                                ShowTabPlacementButton="{Binding ShowTabPlacementButton}" />
                    <DockSplitter Grid.Row="1" />
                    <DockRegion Grid.Row="2"
                                ItemsSource="{Binding LeftBottomTabs}"
                                ShowMaximizeButton="{Binding ShowMaximizeButton}"
                                ShowTabPlacementButton="{Binding ShowTabPlacementButton}" />
                </Grid>
                <DockSplitter Grid.Column="1" />
                <DockRegion Grid.Column="2"
                            ItemsSource="{Binding RightTabs}"
                            AddTabCommand="{Binding AddRightTabCommand}"
                            ShowAddButton="True"
                            ShowMaximizeButton="{Binding ShowMaximizeButton}"
                            ShowTabPlacementButton="{Binding ShowTabPlacementButton}" />
            </Grid>
            </DockShell>
    </Grid>

</Window>
