<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GOZA.Dock.Demo.ViewModels"
             x:Class="GOZA.Dock.Demo.Views.HomeTabView"
             x:DataType="vm:HomeTabViewModel">
  <ScrollViewer>
    <StackPanel Margin="8,8,4,8" Spacing="2">
      <TextBlock Margin="4,2,0,8" FontSize="11" FontWeight="SemiBold" Opacity="0.85" Text="EXPLORER" />
      <ItemsControl ItemsSource="{Binding Nodes}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ExplorerNode">
            <Panel>
              <Button Classes="workbench explorer-item"
                      Margin="{Binding Margin}"
                      IsVisible="{Binding IsActionable}"
                      Command="{Binding $parent[UserControl].((vm:HomeTabViewModel)DataContext).OpenNodeCommand}"
                      CommandParameter="{Binding}"
                      ToolTip.Tip="Open this file in the editor">
                <TextBlock Foreground="{Binding Accent}" Text="{Binding Label}" />
              </Button>
              <TextBlock Margin="{Binding Margin}"
                         IsVisible="{Binding !IsActionable}"
                         Foreground="{Binding Accent}"
                         Text="{Binding Label}" />
            </Panel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
