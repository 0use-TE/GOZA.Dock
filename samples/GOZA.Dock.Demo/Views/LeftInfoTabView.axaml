<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GOZA.Dock.Demo.ViewModels"
             x:Class="GOZA.Dock.Demo.Views.LeftInfoTabView"
             x:DataType="vm:LeftInfoTabViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="10,10,8,8">
    <TextBlock FontSize="11" FontWeight="SemiBold" Opacity="0.85" Text="SEARCH" />
    <TextBox Grid.Row="1" Margin="0,8,0,0" PlaceholderText="Search"
             Text="{Binding Query}" />
    <TextBlock Grid.Row="2" Margin="0,10,0,6" FontSize="12" Opacity="0.7"
               Text="{Binding ResultSummary}" />
    <ScrollViewer Grid.Row="3">
      <ItemsControl ItemsSource="{Binding FilteredHits}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SearchHit">
            <StackPanel Margin="0,0,0,8" Spacing="2">
              <TextBlock FontSize="12" Text="{Binding Location}" />
              <TextBlock Margin="12,0,0,0" FontSize="12" Opacity="0.7" Text="{Binding Preview}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
