<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GOZA.Dock.Demo.ViewModels"
             x:Class="GOZA.Dock.Demo.Views.MainView"
             x:DataType="vm:MainViewModel"
             ViewModelLocator.AutoWireViewModel="True"
             MinWidth="320"
             MinHeight="240">
  <Grid>
    <DockPanel>
      <Menu DockPanel.Dock="Top">
        <MenuItem Header="_Layout">
          <MenuItem Header="_Save layout"
                    Command="{Binding SaveLayoutCommand}" />
          <MenuItem Header="_Load layout"
                    Command="{Binding LoadLayoutCommand}" />
          <Separator />
          <MenuItem Header="_Reset default"
                    Command="{Binding ResetLayoutCommand}" />
        </MenuItem>
        <MenuItem Header="_View">
          <MenuItem Header="Home"
                    Command="{Binding OpenTabCommand}"
                    CommandParameter="{Binding HomeTab}" />
          <MenuItem Header="Info"
                    Command="{Binding OpenTabCommand}"
                    CommandParameter="{Binding InfoTab}" />
          <MenuItem Header="Chart"
                    Command="{Binding OpenTabCommand}"
                    CommandParameter="{Binding ChartTab}" />
          <MenuItem Header="Log"
                    Command="{Binding OpenTabCommand}"
                    CommandParameter="{Binding LogTab}" />
          <MenuItem Header="Browser"
                    Command="{Binding OpenTabCommand}"
                    CommandParameter="{Binding BrowserTab}" />
          <MenuItem Header="Tools"
                    Command="{Binding OpenTabCommand}"
                    CommandParameter="{Binding ToolsTab}" />
          <MenuItem Header="Guide"
                    Command="{Binding OpenTabCommand}"
                    CommandParameter="{Binding GuideTab}" />
          <Separator />
          <MenuItem Header="{Binding ThemeToggleLabel}"
                    Command="{Binding ToggleThemeCommand}" />
        </MenuItem>
      </Menu>
      <DockShell x:Name="Shell">
        <Grid ColumnDefinitions="*,Auto,2*,Auto,*">
          <DockRegion Grid.Column="0"
                      TabStripPlacement="Left"
                      ItemsSource="{Binding LeftTabs}"
                      SelectedItem="{Binding LeftSelected, Mode=TwoWay}" />

          <DockSplitter Grid.Column="1" />

          <Grid Grid.Column="2" RowDefinitions="2*,Auto,*">
            <DockRegion Grid.Row="0"
                        TabStripPlacement="Top"
                        ShowAddButton="True"
                        AddTabCommand="{Binding AddDocCommand}"
                        ItemsSource="{Binding CenterTopTabs}"
                        SelectedItem="{Binding CenterTopSelected, Mode=TwoWay}" />

            <DockSplitter Grid.Row="1" />

            <DockRegion Grid.Row="2"
                        ItemsSource="{Binding CenterBottomTabs}"
                        SelectedItem="{Binding CenterBottomSelected, Mode=TwoWay}" />
          </Grid>

          <DockSplitter Grid.Column="3" />

          <DockRegion Grid.Column="4"
                      TabStripPlacement="Right"
                      ItemsSource="{Binding RightTabs}"
                      SelectedItem="{Binding RightSelected, Mode=TwoWay}" />
        </Grid>
      </DockShell>
    </DockPanel>

    <Border Margin="16"
            MaxWidth="380"
            Padding="12,10"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="#E6282828"
            BorderBrush="#661878D4"
            BorderThickness="1"
            CornerRadius="8"
            IsVisible="{Binding IsNotificationVisible}"
            IsHitTestVisible="False">
      <StackPanel Spacing="6">
        <TextBlock FontWeight="SemiBold"
                   Foreground="#F2FFFFFF"
                   Text="{Binding NotificationTitle}" />
        <TextBlock Foreground="#E6FFFFFF"
                   LineHeight="20"
                   Text="{Binding NotificationBody}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
