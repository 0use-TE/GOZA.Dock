<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>GOZA.Dock</RootNamespace>
    <AssemblyName>GOZA.Dock</AssemblyName>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <InformationalVersion>1.0.1</InformationalVersion>

    <Title>GOZA.Dock</Title>
    <Description>Cross-platform Avalonia docking layout with draggable tab regions, optional view parking lot, and layout expansion.</Description>
    <PackageId>GOZA.Dock</PackageId>
    <Authors>GOZA</Authors>
    <PackageTags>Avalonia;Dock;Layout;Tabs;IDE</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/0use-TE/GOZA.Dock</PackageProjectUrl>
    <RepositoryUrl>https://github.com/0use-TE/GOZA.Dock</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>package-icon.png</PackageIcon>
    <PackageReleaseNotes>Parking lot: Release/Activate match reusable surfaces by tab Id; DataContext refreshed on activate. Requires Avalonia 12.0.0.</PackageReleaseNotes>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="wwwroot\package-icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Themes\**\*.axaml" />
  </ItemGroup>

</Project>
