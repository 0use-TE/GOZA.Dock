<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>GOZA.Dock</RootNamespace>
		<AssemblyName>GOZA.Dock</AssemblyName>
		<LangVersion>latest</LangVersion>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<IsAotCompatible>true</IsAotCompatible>
		<Version>3.0.8</Version>

		<Title>GOZA.Dock</Title>
		<Description>Cross-platform, AOT-first Avalonia tab workspace with fixed regions, draggable tabs, self-contained Dock chrome, and optional view reuse.</Description>
		<PackageId>GOZA.Dock</PackageId>
		<Authors>GOZA</Authors>
		<PackageTags>Avalonia;Dock;Layout;Tabs;IDE</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/0use-TE/GOZA.Dock</PackageProjectUrl>
		<RepositoryUrl>https://github.com/0use-TE/GOZA.Dock</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>GOZA.png</PackageIcon>
		<PackageReleaseNotes>3.0.8: IDockSurfaceLifecycle for cached tab surfaces; selection now parks the hosted surface; vertical tab drag previews keep the live footprint.</PackageReleaseNotes>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="wwwroot\GOZA.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" />
	</ItemGroup>

	<ItemGroup>
		<AvaloniaResource Include="Themes\**\*.axaml" />
	</ItemGroup>

</Project>
