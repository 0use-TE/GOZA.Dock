<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GOZA.Dock.Controls.DockChromeIcon"
             x:Name="Root"
             Width="16"
             Height="16">
  <Viewbox Stretch="Uniform">
    <Path x:Name="IconPath"
          Width="20"
          Height="20"
          Stretch="None"
          Stroke="{DynamicResource DockChromeIconForegroundBrush}"
          StrokeLineCap="Round"
          StrokeThickness="1.8" />
  </Viewbox>
</UserControl>
