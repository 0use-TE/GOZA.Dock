<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- DockSplitter uses GridSplitter styling; gutter line is drawn in OnRender to keep ShowsPreview working -->
  <Style Selector=":is(GridSplitter)">
    <Setter Property="ShowsPreview" Value="True" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="MinHeight" Value="10" />
  </Style>

  <!-- DockRegion: TabControl is header-only; real content lives in ContentHost -->
  <Style Selector="DockRegion TabControl#TabStrip">
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="DockRegion TabControl#TabStrip[TabStripPlacement=Left]">
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="DockRegion TabControl#TabStrip[TabStripPlacement=Right]">
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="DockRegion TabControl#TabStrip /template/ ContentPresenter#PART_SelectedContentHost">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Height" Value="0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <Style Selector="DockRegion Button.dock-tab-close">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Opacity" Value="0.65" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="DockRegion Button.dock-tab-close:pointerover">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="DockRegion Button.dock-add-doc">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="MinWidth" Value="24" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="#1888D4" />
    <Setter Property="Opacity" Value="0.85" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="DockRegion Button.dock-add-doc:pointerover">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- Keys match GOZA.Dock.DockThemeResources — override in app styles after this include -->
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="DockDropHintBackgroundBrush" Color="#331878D4" />
          <SolidColorBrush x:Key="DockDropHintBorderBrush" Color="#661878D4" />
          <SolidColorBrush x:Key="DockDragGhostBackgroundBrush" Color="#F2FFFFFF" />
          <SolidColorBrush x:Key="DockDragGhostBorderBrush" Color="#B0B0B0B0" />
          <SolidColorBrush x:Key="DockDragGhostForegroundBrush" Color="#E6000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="DockDropHintBackgroundBrush" Color="#66808080" />
          <SolidColorBrush x:Key="DockDropHintBorderBrush" Color="#AA909090" />
          <SolidColorBrush x:Key="DockDragGhostBackgroundBrush" Color="#EE404040" />
          <SolidColorBrush x:Key="DockDragGhostBorderBrush" Color="#AA909090" />
          <SolidColorBrush x:Key="DockDragGhostForegroundBrush" Color="#F2FFFFFF" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
</Styles>
