<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:GOZA.Dock.Controls"
        xmlns:dock="using:GOZA.Dock">
  <Styles.Resources>
    <ResourceDictionary>
      <!-- Structural metrics. Applications may override any key after this include. -->
      <!-- VS Code workbench.sash.size default (desktop). -->
      <x:Double x:Key="DockPaneGap">4</x:Double>
      <!-- Modern UI: 24px pill + 4px transparent hit gutter on each side. -->
      <x:Double x:Key="DockTabHeight">32</x:Double>
      <x:Double x:Key="DockTabPillHeight">24</x:Double>
      <x:Double x:Key="DockChromeButtonSize">28</x:Double>
      <Thickness x:Key="DockShellPadding">4</Thickness>
      <Thickness x:Key="DockPaneBorderThickness">1</Thickness>
      <!-- VS Code Modern UI tabs.css: left 6px, right 8px. The action overlay
           is 24px wide with 2px inline margin; its 20px action is centered. -->
      <Thickness x:Key="DockTabPadding">6,0,8,0</Thickness>
      <Thickness x:Key="DockTabPaddingClosable">6,0,2,0</Thickness>
      <Thickness x:Key="DockTabCloseGap">0</Thickness>
      <x:Double x:Key="DockTabCloseActionWidth">24</x:Double>
      <x:Double x:Key="DockTabCloseSurfaceSize">20</x:Double>
      <CornerRadius x:Key="DockPaneCornerRadius">8</CornerRadius>
      <CornerRadius x:Key="DockTabCornerRadius">4</CornerRadius>
      <CornerRadius x:Key="DockTabCornerRadiusTop">4</CornerRadius>
      <CornerRadius x:Key="DockTabCornerRadiusBottom">4</CornerRadius>
      <CornerRadius x:Key="DockTabCornerRadiusLeft">4</CornerRadius>
      <CornerRadius x:Key="DockTabCornerRadiusRight">4</CornerRadius>
      <Thickness x:Key="DockDragGhostBorderThickness">1</Thickness>
      <CornerRadius x:Key="DockDragGhostCornerRadius">4</CornerRadius>
      <Thickness x:Key="DockDragGhostPadding">8,4</Thickness>
      <Thickness x:Key="DockDropHintBorderThickness">1</Thickness>

      <!--
        Workbench colors use official VS Code color IDs (theme JSON "colors" keys).
        Override any of these after StyleInclude to apply a third-party VS Code theme.
        Defaults = Dark Modern / Light Modern from vscode theme-defaults.
      -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <SolidColorBrush x:Key="editor.background" Color="#1F1F1F" />
          <SolidColorBrush x:Key="editor.foreground" Color="#CCCCCC" />
          <SolidColorBrush x:Key="editorGroup.border" Color="#2B2B2B" />
          <SolidColorBrush x:Key="editorGroup.dropBackground" Color="#8053595D" />
          <SolidColorBrush x:Key="editorGroupHeader.tabsBackground" Color="#181818" />
          <SolidColorBrush x:Key="editorGroupHeader.tabsBorder" Color="#2B2B2B" />
          <SolidColorBrush x:Key="editor.border" Color="#2B2B2B" />
          <SolidColorBrush x:Key="surface.background" Color="#181818" />
          <SolidColorBrush x:Key="surface.foreground" Color="#CCCCCC" />
          <SolidColorBrush x:Key="surface.border" Color="#2B2B2B" />
          <SolidColorBrush x:Key="modernEditorTab.activeBackground" Color="#2C2D2E" />
          <SolidColorBrush x:Key="modernEditorTab.activeForeground" Color="#EDEDED" />
          <SolidColorBrush x:Key="modernEditorTab.inactiveBackground" Color="Transparent" />
          <SolidColorBrush x:Key="modernEditorTab.hoverBackground" Color="#14FFFFFF" />
          <SolidColorBrush x:Key="modernEditorTab.hoverForeground" Color="#CCCCCC" />
          <SolidColorBrush x:Key="modernEditorTab.activeHoverBackground" Color="#14FFFFFF" />
          <SolidColorBrush x:Key="modernEditorTab.activeActionBackground" Color="#2C2D2E" />
          <SolidColorBrush x:Key="modernEditorTab.hoverActionBackground" Color="#2C2D2E" />
          <SolidColorBrush x:Key="modernEditorTab.activeHoverActionBackground" Color="#2C2D2E" />
          <SolidColorBrush x:Key="modernEditorTab.selectedActionBackground" Color="#2C2D2E" />
          <SolidColorBrush x:Key="tab.activeBackground" Color="#1F1F1F" />
          <SolidColorBrush x:Key="tab.inactiveBackground" Color="#181818" />
          <SolidColorBrush x:Key="tab.activeForeground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="tab.inactiveForeground" Color="#9D9D9D" />
          <SolidColorBrush x:Key="tab.selectedBackground" Color="#1F1F1F" />
          <SolidColorBrush x:Key="tab.selectedForeground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="tab.hoverBackground" Color="#1F1F1F" />
          <SolidColorBrush x:Key="tab.hoverForeground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="tab.border" Color="#2B2B2B" />
          <SolidColorBrush x:Key="tab.activeBorder" Color="#1F1F1F" />
          <SolidColorBrush x:Key="tab.activeBorderTop" Color="#0078D4" />
          <SolidColorBrush x:Key="tab.selectedBorderTop" Color="#6CADDF" />
          <SolidColorBrush x:Key="tab.unfocusedActiveBackground" Color="#1F1F1F" />
          <SolidColorBrush x:Key="tab.unfocusedActiveForeground" Color="#9D9D9D" />
          <SolidColorBrush x:Key="tab.unfocusedInactiveBackground" Color="#181818" />
          <SolidColorBrush x:Key="tab.unfocusedInactiveForeground" Color="#6B6B6B" />
          <SolidColorBrush x:Key="tab.unfocusedHoverBackground" Color="#1F1F1F" />
          <SolidColorBrush x:Key="tab.unfocusedHoverForeground" Color="#9D9D9D" />
          <SolidColorBrush x:Key="tab.unfocusedActiveBorder" Color="#1F1F1F" />
          <SolidColorBrush x:Key="tab.unfocusedActiveBorderTop" Color="#2B2B2B" />
          <SolidColorBrush x:Key="panel.background" Color="#181818" />
          <SolidColorBrush x:Key="panel.border" Color="#2B2B2B" />
          <SolidColorBrush x:Key="panelTitle.activeForeground" Color="#CCCCCC" />
          <SolidColorBrush x:Key="panelTitle.inactiveForeground" Color="#9D9D9D" />
          <SolidColorBrush x:Key="panelTitle.activeBorder" Color="#0078D4" />
          <SolidColorBrush x:Key="sideBar.background" Color="#181818" />
          <SolidColorBrush x:Key="sideBar.foreground" Color="#CCCCCC" />
          <SolidColorBrush x:Key="sideBar.border" Color="#2B2B2B" />
          <SolidColorBrush x:Key="sideBarTitle.foreground" Color="#CCCCCC" />
          <SolidColorBrush x:Key="sideBarSectionHeader.background" Color="#181818" />
          <SolidColorBrush x:Key="sideBarSectionHeader.foreground" Color="#CCCCCC" />
          <SolidColorBrush x:Key="sideBarSectionHeader.border" Color="#2B2B2B" />
          <SolidColorBrush x:Key="focusBorder" Color="#0078D4" />
          <SolidColorBrush x:Key="foreground" Color="#CCCCCC" />
          <SolidColorBrush x:Key="icon.foreground" Color="#CCCCCC" />
          <SolidColorBrush x:Key="sash.hoverBorder" Color="#0078D4" />
          <SolidColorBrush x:Key="toolbar.hoverBackground" Color="#505A5D5E" />
          <SolidColorBrush x:Key="toolbar.hoverOutline" Color="Transparent" />
          <SolidColorBrush x:Key="toolbar.activeBackground" Color="#805A5D5E" />
          <SolidColorBrush x:Key="titleBar.activeBackground" Color="#181818" />
          <SolidColorBrush x:Key="titleBar.activeForeground" Color="#CCCCCC" />
          <SolidColorBrush x:Key="titleBar.border" Color="#2B2B2B" />
          <SolidColorBrush x:Key="DockDragGhostBackgroundBrush" Color="#F01F1F1F" />
          <SolidColorBrush x:Key="DockDragGhostBorderBrush" Color="#AA2B2B2B" />
          <SolidColorBrush x:Key="DockDragGhostForegroundBrush" Color="#FFFFFF" />
          <!-- Same family as drag ghost: muted wash + soft border (no focusBorder neon). -->
          <SolidColorBrush x:Key="DockDropHintBackgroundBrush" Color="#9953595D" />
          <SolidColorBrush x:Key="DockDropHintBorderBrush" Color="#AA2B2B2B" />
          <SolidColorBrush x:Key="DockTabCloseHoverBackground" Color="#28FFFFFF" />
          <SolidColorBrush x:Key="DockTabClosePressedBackground" Color="#3CFFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="editor.background" Color="#1F1F1F" />
          <SolidColorBrush x:Key="editor.foreground" Color="#CCCCCC" />
          <SolidColorBrush x:Key="editorGroup.border" Color="#2B2B2B" />
          <SolidColorBrush x:Key="editorGroup.dropBackground" Color="#8053595D" />
          <SolidColorBrush x:Key="editorGroupHeader.tabsBackground" Color="#181818" />
          <SolidColorBrush x:Key="editorGroupHeader.tabsBorder" Color="#2B2B2B" />
          <SolidColorBrush x:Key="editor.border" Color="#2B2B2B" />
          <SolidColorBrush x:Key="surface.background" Color="#181818" />
          <SolidColorBrush x:Key="surface.foreground" Color="#CCCCCC" />
          <SolidColorBrush x:Key="surface.border" Color="#2B2B2B" />
          <SolidColorBrush x:Key="modernEditorTab.activeBackground" Color="#2C2D2E" />
          <SolidColorBrush x:Key="modernEditorTab.activeForeground" Color="#EDEDED" />
          <SolidColorBrush x:Key="modernEditorTab.inactiveBackground" Color="Transparent" />
          <SolidColorBrush x:Key="modernEditorTab.hoverBackground" Color="#14FFFFFF" />
          <SolidColorBrush x:Key="modernEditorTab.hoverForeground" Color="#CCCCCC" />
          <SolidColorBrush x:Key="modernEditorTab.activeHoverBackground" Color="#14FFFFFF" />
          <SolidColorBrush x:Key="modernEditorTab.activeActionBackground" Color="#2C2D2E" />
          <SolidColorBrush x:Key="modernEditorTab.hoverActionBackground" Color="#2C2D2E" />
          <SolidColorBrush x:Key="modernEditorTab.activeHoverActionBackground" Color="#2C2D2E" />
          <SolidColorBrush x:Key="modernEditorTab.selectedActionBackground" Color="#2C2D2E" />
          <SolidColorBrush x:Key="tab.activeBackground" Color="#1F1F1F" />
          <SolidColorBrush x:Key="tab.inactiveBackground" Color="#181818" />
          <SolidColorBrush x:Key="tab.activeForeground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="tab.inactiveForeground" Color="#9D9D9D" />
          <SolidColorBrush x:Key="tab.selectedBackground" Color="#1F1F1F" />
          <SolidColorBrush x:Key="tab.selectedForeground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="tab.hoverBackground" Color="#1F1F1F" />
          <SolidColorBrush x:Key="tab.hoverForeground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="tab.border" Color="#2B2B2B" />
          <SolidColorBrush x:Key="tab.activeBorder" Color="#1F1F1F" />
          <SolidColorBrush x:Key="tab.activeBorderTop" Color="#0078D4" />
          <SolidColorBrush x:Key="tab.selectedBorderTop" Color="#6CADDF" />
          <SolidColorBrush x:Key="tab.unfocusedActiveBackground" Color="#1F1F1F" />
          <SolidColorBrush x:Key="tab.unfocusedActiveForeground" Color="#9D9D9D" />
          <SolidColorBrush x:Key="tab.unfocusedInactiveBackground" Color="#181818" />
          <SolidColorBrush x:Key="tab.unfocusedInactiveForeground" Color="#6B6B6B" />
          <SolidColorBrush x:Key="tab.unfocusedHoverBackground" Color="#1F1F1F" />
          <SolidColorBrush x:Key="tab.unfocusedHoverForeground" Color="#9D9D9D" />
          <SolidColorBrush x:Key="tab.unfocusedActiveBorder" Color="#1F1F1F" />
          <SolidColorBrush x:Key="tab.unfocusedActiveBorderTop" Color="#2B2B2B" />
          <SolidColorBrush x:Key="panel.background" Color="#181818" />
          <SolidColorBrush x:Key="panel.border" Color="#2B2B2B" />
          <SolidColorBrush x:Key="panelTitle.activeForeground" Color="#CCCCCC" />
          <SolidColorBrush x:Key="panelTitle.inactiveForeground" Color="#9D9D9D" />
          <SolidColorBrush x:Key="panelTitle.activeBorder" Color="#0078D4" />
          <SolidColorBrush x:Key="sideBar.background" Color="#181818" />
          <SolidColorBrush x:Key="sideBar.foreground" Color="#CCCCCC" />
          <SolidColorBrush x:Key="sideBar.border" Color="#2B2B2B" />
          <SolidColorBrush x:Key="sideBarTitle.foreground" Color="#CCCCCC" />
          <SolidColorBrush x:Key="sideBarSectionHeader.background" Color="#181818" />
          <SolidColorBrush x:Key="sideBarSectionHeader.foreground" Color="#CCCCCC" />
          <SolidColorBrush x:Key="sideBarSectionHeader.border" Color="#2B2B2B" />
          <SolidColorBrush x:Key="focusBorder" Color="#0078D4" />
          <SolidColorBrush x:Key="foreground" Color="#CCCCCC" />
          <SolidColorBrush x:Key="icon.foreground" Color="#CCCCCC" />
          <SolidColorBrush x:Key="sash.hoverBorder" Color="#0078D4" />
          <SolidColorBrush x:Key="toolbar.hoverBackground" Color="#505A5D5E" />
          <SolidColorBrush x:Key="toolbar.hoverOutline" Color="Transparent" />
          <SolidColorBrush x:Key="toolbar.activeBackground" Color="#805A5D5E" />
          <SolidColorBrush x:Key="titleBar.activeBackground" Color="#181818" />
          <SolidColorBrush x:Key="titleBar.activeForeground" Color="#CCCCCC" />
          <SolidColorBrush x:Key="titleBar.border" Color="#2B2B2B" />
          <SolidColorBrush x:Key="DockDragGhostBackgroundBrush" Color="#F01F1F1F" />
          <SolidColorBrush x:Key="DockDragGhostBorderBrush" Color="#AA2B2B2B" />
          <SolidColorBrush x:Key="DockDragGhostForegroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="DockDropHintBackgroundBrush" Color="#9953595D" />
          <SolidColorBrush x:Key="DockDropHintBorderBrush" Color="#AA2B2B2B" />
          <SolidColorBrush x:Key="DockTabCloseHoverBackground" Color="#28FFFFFF" />
          <SolidColorBrush x:Key="DockTabClosePressedBackground" Color="#3CFFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="editor.background" Color="#FFFFFF" />
          <SolidColorBrush x:Key="editor.foreground" Color="#3B3B3B" />
          <SolidColorBrush x:Key="editorGroup.border" Color="#E5E5E5" />
          <SolidColorBrush x:Key="editorGroup.dropBackground" Color="#2E2677CB" />
          <SolidColorBrush x:Key="editorGroupHeader.tabsBackground" Color="#F8F8F8" />
          <SolidColorBrush x:Key="editorGroupHeader.tabsBorder" Color="#E5E5E5" />
          <SolidColorBrush x:Key="editor.border" Color="#E5E5E5" />
          <SolidColorBrush x:Key="surface.background" Color="#FFFFFF" />
          <SolidColorBrush x:Key="surface.foreground" Color="#3B3B3B" />
          <SolidColorBrush x:Key="surface.border" Color="#E5E5E5" />
          <SolidColorBrush x:Key="modernEditorTab.activeBackground" Color="#99DADADA" />
          <SolidColorBrush x:Key="modernEditorTab.activeForeground" Color="#202020" />
          <SolidColorBrush x:Key="modernEditorTab.inactiveBackground" Color="Transparent" />
          <SolidColorBrush x:Key="modernEditorTab.hoverBackground" Color="#14000000" />
          <SolidColorBrush x:Key="modernEditorTab.hoverForeground" Color="#202020" />
          <SolidColorBrush x:Key="modernEditorTab.activeHoverBackground" Color="#14000000" />
          <SolidColorBrush x:Key="modernEditorTab.activeActionBackground" Color="#E2E2E2" />
          <SolidColorBrush x:Key="modernEditorTab.hoverActionBackground" Color="#E8E8E8" />
          <SolidColorBrush x:Key="modernEditorTab.activeHoverActionBackground" Color="#E2E2E2" />
          <SolidColorBrush x:Key="modernEditorTab.selectedActionBackground" Color="#E2E2E2" />
          <SolidColorBrush x:Key="tab.activeBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="tab.inactiveBackground" Color="#F8F8F8" />
          <SolidColorBrush x:Key="tab.activeForeground" Color="#3B3B3B" />
          <SolidColorBrush x:Key="tab.inactiveForeground" Color="#868686" />
          <SolidColorBrush x:Key="tab.selectedBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="tab.selectedForeground" Color="#3B3B3B" />
          <SolidColorBrush x:Key="tab.hoverBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="tab.hoverForeground" Color="#3B3B3B" />
          <SolidColorBrush x:Key="tab.border" Color="#E5E5E5" />
          <SolidColorBrush x:Key="tab.activeBorder" Color="#F8F8F8" />
          <SolidColorBrush x:Key="tab.activeBorderTop" Color="#005FB8" />
          <SolidColorBrush x:Key="tab.selectedBorderTop" Color="#68A3DA" />
          <SolidColorBrush x:Key="tab.unfocusedActiveBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="tab.unfocusedActiveForeground" Color="#868686" />
          <SolidColorBrush x:Key="tab.unfocusedInactiveBackground" Color="#F8F8F8" />
          <SolidColorBrush x:Key="tab.unfocusedInactiveForeground" Color="#B5B5B5" />
          <SolidColorBrush x:Key="tab.unfocusedHoverBackground" Color="#F8F8F8" />
          <SolidColorBrush x:Key="tab.unfocusedHoverForeground" Color="#868686" />
          <SolidColorBrush x:Key="tab.unfocusedActiveBorder" Color="#F8F8F8" />
          <SolidColorBrush x:Key="tab.unfocusedActiveBorderTop" Color="#E5E5E5" />
          <SolidColorBrush x:Key="panel.background" Color="#F8F8F8" />
          <SolidColorBrush x:Key="panel.border" Color="#E5E5E5" />
          <SolidColorBrush x:Key="panelTitle.activeForeground" Color="#3B3B3B" />
          <SolidColorBrush x:Key="panelTitle.inactiveForeground" Color="#868686" />
          <SolidColorBrush x:Key="panelTitle.activeBorder" Color="#005FB8" />
          <SolidColorBrush x:Key="sideBar.background" Color="#F8F8F8" />
          <SolidColorBrush x:Key="sideBar.foreground" Color="#3B3B3B" />
          <SolidColorBrush x:Key="sideBar.border" Color="#E5E5E5" />
          <SolidColorBrush x:Key="sideBarTitle.foreground" Color="#3B3B3B" />
          <SolidColorBrush x:Key="sideBarSectionHeader.background" Color="#F8F8F8" />
          <SolidColorBrush x:Key="sideBarSectionHeader.foreground" Color="#3B3B3B" />
          <SolidColorBrush x:Key="sideBarSectionHeader.border" Color="#E5E5E5" />
          <SolidColorBrush x:Key="focusBorder" Color="#005FB8" />
          <SolidColorBrush x:Key="foreground" Color="#3B3B3B" />
          <SolidColorBrush x:Key="icon.foreground" Color="#3B3B3B" />
          <SolidColorBrush x:Key="sash.hoverBorder" Color="#005FB8" />
          <SolidColorBrush x:Key="toolbar.hoverBackground" Color="#50B8B8B8" />
          <SolidColorBrush x:Key="toolbar.hoverOutline" Color="Transparent" />
          <SolidColorBrush x:Key="toolbar.activeBackground" Color="#80B8B8B8" />
          <SolidColorBrush x:Key="titleBar.activeBackground" Color="#F8F8F8" />
          <SolidColorBrush x:Key="titleBar.activeForeground" Color="#3B3B3B" />
          <SolidColorBrush x:Key="titleBar.border" Color="#E5E5E5" />
          <SolidColorBrush x:Key="DockDragGhostBackgroundBrush" Color="#F2FFFFFF" />
          <SolidColorBrush x:Key="DockDragGhostBorderBrush" Color="#AAE5E5E5" />
          <SolidColorBrush x:Key="DockDragGhostForegroundBrush" Color="#3B3B3B" />
          <SolidColorBrush x:Key="DockDropHintBackgroundBrush" Color="#33999999" />
          <SolidColorBrush x:Key="DockDropHintBorderBrush" Color="#AAE5E5E5" />
          <SolidColorBrush x:Key="DockTabCloseHoverBackground" Color="#14000000" />
          <SolidColorBrush x:Key="DockTabClosePressedBackground" Color="#24000000" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <ItemsPanelTemplate x:Key="DockHorizontalTabPanel">
        <StackPanel Orientation="Horizontal" Spacing="0" />
      </ItemsPanelTemplate>
      <ItemsPanelTemplate x:Key="DockVerticalTabPanel">
        <StackPanel Orientation="Vertical" Spacing="0" />
      </ItemsPanelTemplate>

      <!-- Private themes for every stock Avalonia control used by Dock chrome. -->
      <ControlTheme x:Key="DockTabStripTheme" TargetType="TabStrip">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
              <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden"
                            BringIntoViewOnFocusChange="True">
                <ItemsPresenter x:Name="PART_ItemsPresenter"
                                ItemsPanel="{TemplateBinding ItemsPanel}" />
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type controls:DockHeaderButton}"
                    TargetType="controls:DockHeaderButton">
        <Setter Property="Width" Value="{DynamicResource DockChromeButtonSize}" />
        <Setter Property="Height" Value="{DynamicResource DockChromeButtonSize}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource toolbar.hoverOutline}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource icon.foreground}" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter x:Name="PART_DockHeaderButtonSurface"
                              Background="Transparent"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="2"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_DockHeaderButtonSurface">
          <Setter Property="Background" Value="{DynamicResource toolbar.hoverBackground}" />
        </Style>
        <Style Selector="^:pressed /template/ ContentPresenter#PART_DockHeaderButtonSurface">
          <Setter Property="Background" Value="{DynamicResource toolbar.activeBackground}" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.45" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="DockContentHostTheme" TargetType="ContentControl">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <DataTemplate x:Key="DockDefaultTabHeaderTemplate" x:DataType="dock:IDockTabItem">
        <controls:DockTabHeader Header="{Binding Header}"
                                IsClosable="{Binding IsClosable}" />
      </DataTemplate>

      <ControlTheme x:Key="DockTabStripItemTheme" TargetType="TabStripItem">
        <!-- Fully own focus rendering; never inherit the host FluentTheme accent fill. -->
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="MinHeight" Value="{DynamicResource DockTabHeight}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <!-- The visible surface is explicitly owned by this theme and resolves through
             VS Code workbench color resources. -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource tab.inactiveForeground}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource DockTabCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border x:Name="PART_DockTabSurface"
                    Margin="2,4"
                    Background="{DynamicResource modernEditorTab.inactiveBackground}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    ClipToBounds="True"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#PART_DockTabSurface">
          <Setter Property="Background" Value="{DynamicResource modernEditorTab.hoverBackground}" />
        </Style>
        <Style Selector="^:selected /template/ Border#PART_DockTabSurface">
          <Setter Property="Background" Value="{DynamicResource modernEditorTab.activeBackground}" />
        </Style>
        <Style Selector="^:selected:pointerover /template/ Border#PART_DockTabSurface">
          <Setter Property="Background" Value="{DynamicResource modernEditorTab.activeHoverBackground}" />
        </Style>
        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{DynamicResource modernEditorTab.hoverForeground}" />
        </Style>
        <Style Selector="^:selected">
          <Setter Property="Foreground" Value="{DynamicResource modernEditorTab.activeForeground}" />
          <Setter Property="ZIndex" Value="1" />
        </Style>
        <Style Selector="^:focus">
          <Setter Property="Foreground" Value="{DynamicResource modernEditorTab.hoverForeground}" />
        </Style>
        <Style Selector="^:focus-visible">
          <Setter Property="Foreground" Value="{DynamicResource modernEditorTab.hoverForeground}" />
        </Style>
        <Style Selector="^:selected:focus">
          <Setter Property="Foreground" Value="{DynamicResource modernEditorTab.activeForeground}" />
        </Style>
        <Style Selector="^:selected:focus-visible">
          <Setter Property="Foreground" Value="{DynamicResource modernEditorTab.activeForeground}" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type controls:DockSplitter}"
                    TargetType="controls:DockSplitter">
        <!-- VS Code sash: live resize only (no drag-preview bar). -->
        <Setter Property="ShowsPreview" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}">
              <Border x:Name="PART_Highlight"
                      Background="{DynamicResource editorGroup.border}" />
            </Border>
          </ControlTemplate>
        </Setter>
        <!-- Modern UI: the 4px sash is also the visible inter-card gutter. -->
        <Style Selector="^:columns /template/ Border#PART_Highlight">
          <Setter Property="Width" Value="0" />
          <Setter Property="HorizontalAlignment" Value="Center" />
          <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="^:rows /template/ Border#PART_Highlight">
          <Setter Property="Height" Value="0" />
          <Setter Property="HorizontalAlignment" Value="Stretch" />
          <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Hover / drag: sash.hoverBorder fills the sash size (VS Code). -->
        <Style Selector="^:pointerover /template/ Border#PART_Highlight">
          <Setter Property="Background" Value="{DynamicResource sash.hoverBorder}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#PART_Highlight">
          <Setter Property="Background" Value="{DynamicResource sash.hoverBorder}" />
        </Style>
        <Style Selector="^:dragging /template/ Border#PART_Highlight">
          <Setter Property="Background" Value="{DynamicResource sash.hoverBorder}" />
        </Style>
        <Style Selector="^:columns:pointerover /template/ Border#PART_Highlight">
          <Setter Property="Width" Value="{DynamicResource DockPaneGap}" />
        </Style>
        <Style Selector="^:columns:pressed /template/ Border#PART_Highlight">
          <Setter Property="Width" Value="{DynamicResource DockPaneGap}" />
        </Style>
        <Style Selector="^:columns:dragging /template/ Border#PART_Highlight">
          <Setter Property="Width" Value="{DynamicResource DockPaneGap}" />
        </Style>
        <Style Selector="^:rows:pointerover /template/ Border#PART_Highlight">
          <Setter Property="Height" Value="{DynamicResource DockPaneGap}" />
        </Style>
        <Style Selector="^:rows:pressed /template/ Border#PART_Highlight">
          <Setter Property="Height" Value="{DynamicResource DockPaneGap}" />
        </Style>
        <Style Selector="^:rows:dragging /template/ Border#PART_Highlight">
          <Setter Property="Height" Value="{DynamicResource DockPaneGap}" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type controls:DockShell}"
                    TargetType="controls:DockShell">
        <Setter Property="Background" Value="{DynamicResource titleBar.activeBackground}" />
        <Setter Property="Padding" Value="{DynamicResource DockShellPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}">
              <Grid>
                <ContentPresenter Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                <Grid x:Name="PART_MaximizedHost"
                      Background="{TemplateBinding Background}"
                      IsVisible="False" />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type controls:DockRegion}"
                    TargetType="controls:DockRegion">
        <Setter Property="Background" Value="{DynamicResource surface.background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource surface.border}" />
        <Setter Property="BorderThickness" Value="{DynamicResource DockPaneBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource DockPaneCornerRadius}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="TabHeaderTemplate" Value="{StaticResource DockDefaultTabHeaderTemplate}" />
        <Setter Property="TabItemTheme" Value="{StaticResource DockTabStripItemTheme}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
              <Border Background="{TemplateBinding Background}"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      ClipToBounds="True">
                <DockPanel LastChildFill="True">
                <Grid x:Name="PART_HeaderHost"
                      DockPanel.Dock="Top"
                      Background="Transparent"
                      ClipToBounds="True">
                  <Border x:Name="PART_HeaderDivider"
                          Height="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Bottom"
                          Background="Transparent"
                          IsHitTestVisible="False" />
                  <DockPanel LastChildFill="True">
                    <StackPanel x:Name="PART_ChromeHost"
                                DockPanel.Dock="Right"
                                Orientation="Horizontal">
                      <controls:DockHeaderButton Classes="dock-add-tab"
                                                   Command="{TemplateBinding AddTabCommand}"
                                                   IsVisible="{TemplateBinding ShowAddButton}">
                        <controls:DockChromeIcon Kind="Add" />
                      </controls:DockHeaderButton>
                      <ContentPresenter Content="{TemplateBinding HeaderContent}"
                                        ContentTemplate="{TemplateBinding HeaderContentTemplate}"
                                        VerticalAlignment="Center" />
                      <controls:DockHeaderButton x:Name="PART_MaximizeButton"
                                                 Classes="dock-maximize"
                                                 ToolTip.Tip="Maximize or restore region"
                                                 IsEnabled="{TemplateBinding CanMaximize}"
                                                 IsVisible="{TemplateBinding ShowMaximizeButton}">
                        <controls:DockChromeIcon x:Name="PART_MaximizeIcon"
                                                 Kind="Maximize" />
                      </controls:DockHeaderButton>
                    </StackPanel>

                    <TabStrip x:Name="PART_TabStrip"
                              Theme="{StaticResource DockTabStripTheme}"
                              ItemsSource="{TemplateBinding ItemsSource}"
                              ItemTemplate="{TemplateBinding TabHeaderTemplate}"
                              ItemContainerTheme="{TemplateBinding TabItemTheme}"
                              ItemsPanel="{StaticResource DockHorizontalTabPanel}"
                              SelectedItem="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch" />
                  </DockPanel>
                </Grid>

                <Grid MinWidth="32" MinHeight="32">
                  <ContentControl x:Name="PART_ContentHost"
                                  Theme="{StaticResource DockContentHostTheme}"
                                  Content="{TemplateBinding ActiveContent}"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalContentAlignment="Stretch" />
                  <Border x:Name="PART_DropHint"
                          Background="{DynamicResource DockDropHintBackgroundBrush}"
                          BorderBrush="{DynamicResource DockDropHintBorderBrush}"
                          BorderThickness="{DynamicResource DockDropHintBorderThickness}"
                          CornerRadius="{DynamicResource DockPaneCornerRadius}"
                          IsVisible="False"
                          IsHitTestVisible="False" />
                </Grid>
                </DockPanel>
              </Border>
            </Border>
          </ControlTemplate>
        </Setter>

        <Style Selector="^:bottom /template/ Grid#PART_HeaderHost">
          <Setter Property="DockPanel.Dock" Value="Bottom" />
        </Style>
        <Style Selector="^:bottom /template/ Border#PART_HeaderDivider">
          <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="^:left /template/ Grid#PART_HeaderHost">
          <Setter Property="DockPanel.Dock" Value="Left" />
        </Style>
        <Style Selector="^:left /template/ Border#PART_HeaderDivider">
          <Setter Property="Width" Value="1" />
          <Setter Property="Height" Value="NaN" />
          <Setter Property="HorizontalAlignment" Value="Right" />
          <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="^:right /template/ Grid#PART_HeaderHost">
          <Setter Property="DockPanel.Dock" Value="Right" />
        </Style>
        <Style Selector="^:right /template/ Border#PART_HeaderDivider">
          <Setter Property="Width" Value="1" />
          <Setter Property="Height" Value="NaN" />
          <Setter Property="HorizontalAlignment" Value="Left" />
          <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="^:header-body-separated /template/ Border#PART_HeaderDivider">
          <Setter Property="ZIndex" Value="1" />
        </Style>
        <Style Selector="^:vertical /template/ TabStrip#PART_TabStrip">
          <Setter Property="ItemsPanel" Value="{StaticResource DockVerticalTabPanel}" />
        </Style>
        <Style Selector="^:vertical /template/ StackPanel#PART_ChromeHost">
          <Setter Property="DockPanel.Dock" Value="Bottom" />
          <Setter Property="Orientation" Value="Vertical" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type controls:DockTabHeader}"
                    TargetType="controls:DockTabHeader">
        <Setter Property="MinHeight" Value="{DynamicResource DockTabPillHeight}" />
        <Setter Property="Template">
          <ControlTemplate>
            <LayoutTransformControl x:Name="PART_HeaderTransform">
              <Grid x:Name="PART_HeaderContent"
                    ColumnDefinitions="*,Auto"
                    Margin="{DynamicResource DockTabPadding}"
                    Background="Transparent">
                <TextBlock x:Name="PART_HeaderText"
                           VerticalAlignment="Center"
                           Foreground="{TemplateBinding Foreground}"
                           Text="{TemplateBinding Header}"
                           TextTrimming="CharacterEllipsis" />
                <controls:DockHeaderButton x:Name="PART_CloseButton"
                                           Grid.Column="1"
                                           Classes="dock-tab-close"
                                           Margin="{DynamicResource DockTabCloseGap}"
                                           VerticalAlignment="Center"
                                           ToolTip.Tip="Close">
                  <controls:DockChromeIcon Kind="Close" />
                </controls:DockHeaderButton>
              </Grid>
            </LayoutTransformControl>
          </ControlTemplate>
        </Setter>
        <!-- VS Code: close sits near the pill's right edge. -->
        <Style Selector="^:closable /template/ Grid#PART_HeaderContent">
          <Setter Property="Margin" Value="{DynamicResource DockTabPaddingClosable}" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type controls:DockChromeIcon}"
                    TargetType="controls:DockChromeIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Template">
          <ControlTemplate>
            <Viewbox Stretch="None">
              <Path x:Name="PART_Icon"
                    Width="16"
                    Height="16"
                    Stretch="None"
                    Fill="{DynamicResource icon.foreground}" />
            </Viewbox>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="controls|DockRegion TabStrip">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- Floating-card tiling: splitters provide the exact 4px inter-card gutter. -->
  <Style Selector="controls|DockRegion">
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="controls|DockShell">
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="{DynamicResource DockShellPadding}" />
  </Style>
  <Style Selector="controls|DockSplitter">
    <Setter Property="Margin" Value="0" />
  </Style>
  <!-- Header strip fuses with tabs: exact shared height / width, flush to pane edge. -->
  <Style Selector="controls|DockRegion:horizontal /template/ Grid#PART_HeaderHost">
    <Setter Property="Height" Value="{DynamicResource DockTabHeight}" />
    <Setter Property="MinHeight" Value="{DynamicResource DockTabHeight}" />
  </Style>
  <Style Selector="controls|DockRegion:vertical /template/ Grid#PART_HeaderHost">
    <Setter Property="Width" Value="{DynamicResource DockTabHeight}" />
    <Setter Property="MinWidth" Value="{DynamicResource DockTabHeight}" />
  </Style>
  <Style Selector="controls|DockRegion:horizontal TabStripItem">
    <Setter Property="Height" Value="{DynamicResource DockTabHeight}" />
  </Style>
  <Style Selector="controls|DockRegion:vertical TabStripItem">
    <Setter Property="Width" Value="{DynamicResource DockTabHeight}" />
  </Style>
  <!-- VS Code Modern UI tabs.css:
       tab-actions = 24px lane with 2px inline margin;
       action-label = 16px icon + 2px padding => 20px hover surface. -->
  <Style Selector="controls|DockRegion TabStripItem controls|DockHeaderButton.dock-tab-close">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Width" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Height" Value="{DynamicResource DockTabCloseActionWidth}" />
    <Setter Property="MinHeight" Value="{DynamicResource DockTabCloseActionWidth}" />
    <Setter Property="MaxHeight" Value="{DynamicResource DockTabCloseActionWidth}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <Style Selector="controls|DockRegion TabStripItem:selected controls|DockHeaderButton.dock-tab-close">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Width" Value="{DynamicResource DockTabCloseActionWidth}" />
    <Setter Property="MinWidth" Value="{DynamicResource DockTabCloseActionWidth}" />
    <Setter Property="Margin" Value="{DynamicResource DockTabCloseGap}" />
    <Setter Property="IsHitTestVisible" Value="True" />
  </Style>
  <Style Selector="controls|DockRegion TabStripItem:pointerover controls|DockHeaderButton.dock-tab-close">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Width" Value="{DynamicResource DockTabCloseActionWidth}" />
    <Setter Property="MinWidth" Value="{DynamicResource DockTabCloseActionWidth}" />
    <Setter Property="Margin" Value="{DynamicResource DockTabCloseGap}" />
    <Setter Property="IsHitTestVisible" Value="True" />
  </Style>
  <!-- Rounded hover square on the X (VS Code tab action). -->
  <Style Selector="controls|DockHeaderButton.dock-tab-close /template/ ContentPresenter#PART_DockHeaderButtonSurface">
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Width" Value="{DynamicResource DockTabCloseSurfaceSize}" />
    <Setter Property="Height" Value="{DynamicResource DockTabCloseSurfaceSize}" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- VS Code toolbar actions use the same centered 20x20 rounded surface.
       The outer button remains header-height, preserving an easy hit target. -->
  <Style Selector="controls|DockHeaderButton.dock-maximize /template/ ContentPresenter#PART_DockHeaderButtonSurface">
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Width" Value="{DynamicResource DockTabCloseSurfaceSize}" />
    <Setter Property="Height" Value="{DynamicResource DockTabCloseSurfaceSize}" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="controls|DockHeaderButton.dock-add-tab /template/ ContentPresenter#PART_DockHeaderButtonSurface">
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Width" Value="{DynamicResource DockTabCloseSurfaceSize}" />
    <Setter Property="Height" Value="{DynamicResource DockTabCloseSurfaceSize}" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="controls|DockHeaderButton.dock-tab-close:pointerover /template/ ContentPresenter#PART_DockHeaderButtonSurface">
    <Setter Property="Background" Value="{DynamicResource DockTabCloseHoverBackground}" />
  </Style>
  <Style Selector="controls|DockHeaderButton.dock-tab-close:pressed /template/ ContentPresenter#PART_DockHeaderButtonSurface">
    <Setter Property="Background" Value="{DynamicResource DockTabClosePressedBackground}" />
  </Style>
  <!-- Overlay drag ghost: close chip matches in-strip sizing (not chrome 28px). -->
  <Style Selector="Border.dock-drag-ghost controls|DockHeaderButton.dock-tab-close">
    <Setter Property="Width" Value="{DynamicResource DockTabCloseButtonSize}" />
    <Setter Property="MinWidth" Value="{DynamicResource DockTabCloseButtonSize}" />
    <Setter Property="Height" Value="{DynamicResource DockTabCloseButtonSize}" />
    <Setter Property="MinHeight" Value="{DynamicResource DockTabCloseButtonSize}" />
    <Setter Property="MaxHeight" Value="{DynamicResource DockTabCloseButtonSize}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="{DynamicResource DockTabCloseGap}" />
    <Setter Property="Opacity" Value="1" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <!-- Square tabs (VS Code). -->
  <Style Selector="controls|DockRegion:top TabStripItem">
    <Setter Property="CornerRadius" Value="{DynamicResource DockTabCornerRadiusTop}" />
  </Style>
  <Style Selector="controls|DockRegion:bottom TabStripItem">
    <Setter Property="CornerRadius" Value="{DynamicResource DockTabCornerRadiusBottom}" />
  </Style>
  <Style Selector="controls|DockRegion:left TabStripItem">
    <Setter Property="CornerRadius" Value="{DynamicResource DockTabCornerRadiusLeft}" />
  </Style>
  <Style Selector="controls|DockRegion:right TabStripItem">
    <Setter Property="CornerRadius" Value="{DynamicResource DockTabCornerRadiusRight}" />
  </Style>
  <!-- Modern UI pills are borderless; the 2px horizontal inset is the visual separator. -->
  <Style Selector="controls|DockRegion:top TabStripItem:not(:selected)">
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="controls|DockRegion:bottom TabStripItem:not(:selected)">
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="controls|DockRegion:left TabStripItem:not(:selected)">
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="controls|DockRegion:right TabStripItem:not(:selected)">
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <!-- Modern UI removes the classic active-border-top accent. -->
  <Style Selector="controls|DockRegion:top TabStripItem:selected">
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="controls|DockRegion:bottom TabStripItem:selected">
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="controls|DockRegion:left TabStripItem:selected">
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="controls|DockRegion:right TabStripItem:selected">
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <!-- Chrome buttons fill the header strip; tab close stays a 20px chip. -->
  <Style Selector="controls|DockRegion:horizontal controls|DockHeaderButton:not(.dock-tab-close)">
    <Setter Property="Height" Value="{DynamicResource DockTabHeight}" />
  </Style>
  <Style Selector="controls|DockRegion:vertical controls|DockHeaderButton:not(.dock-tab-close)">
    <Setter Property="Width" Value="{DynamicResource DockTabHeight}" />
  </Style>
  <Style Selector="controls|DockRegion:left controls|DockTabHeader /template/ LayoutTransformControl#PART_HeaderTransform">
    <Setter Property="LayoutTransform">
      <RotateTransform Angle="-90" />
    </Setter>
  </Style>
  <Style Selector="controls|DockRegion:right controls|DockTabHeader /template/ LayoutTransformControl#PART_HeaderTransform">
    <Setter Property="LayoutTransform">
      <RotateTransform Angle="90" />
    </Setter>
  </Style>

</Styles>
